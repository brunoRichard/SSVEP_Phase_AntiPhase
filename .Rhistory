mergedCensusTractDF <- merge(censusTrackMap, countsOfCars, by.x = "GEOID", by.y = "X2020.Census.Tract")
carTypes <- levels(mergedCensusTractDF$Electric.Vehicle.Type)
par(mai = c(0,0,.1,0), omi = c(0,0,.5,.6))
for (ii in 1:2){
evTypeDF <- mergedCensusTractDF[mergedCensusTractDF$Electric.Vehicle.Type == carTypes[ii], ]
# evTypeDF$freq[is.na(evTypeDF$freq)] <-0
layout(matrix(c(1,2), nrow = 1, ncol = 2), widths = c(.975,.025), heights = c(1,1))
theColourRamp <- colorRampPalette(c("gray75", colours[ii]), bias = 10,interpolate = "linear")
nColors <- pretty(range(log10(evTypeDF$freq+1)), 100)
theColours <- theColourRamp(length(nColors))
theTrackColours <- NULL
for (C in 1:length(nColors)){
theTrackColours[log10(evTypeDF$freq+1) >= nColors[C] & log10(evTypeDF$freq+1) < nColors[C+1]] <- theColours[C]
}
plot(evTypeDF$geometry, col = theTrackColours, lwd = 0.5)
plot(x = NULL, y = NULL, xlim = c(0,.1), ylim = c(0,length(nColors)-1), axes = FALSE, ann = FALSE)
for (c in 1:length(nColors)){
rect(0, c-1, .3, c, col = theColours[c], border = NA)
}
theExps <- round(nColors[seq(1,length(nColors), length.out = 10)],2)
for (iii in 1:length(theExps)){
mtext(bquote(10^.(theExps[iii])), 4,
at = seq(1,length(nColors),length.out = 10)[iii],
las = 1, cex = .8, line = .2)
}
mtext("Number of\nCars", 3, font = 2)
}
medianPrice <- aggregate(Base.MSRP ~ X2020.Census.Tract , data = evData2, FUN = median)
mergedMedianPriceDF <- merge(censusTrackMap, medianPrice, by.x = "GEOID", by.y = "X2020.Census.Tract")
par(mai = c(0,0,.1,0), omi = c(0,0,.5,.5))
layout(matrix(c(1,2), nrow = 1, ncol = 2), widths = c(.975,.025), heights = c(1,1))
theColourRamp <- colorRampPalette(c("gray75", colours[3]), bias = 10,interpolate = "linear")
nColors <- pretty(range(mergedMedianPriceDF$Base.MSRP), 100)
theColours <- theColourRamp(length(nColors))
theTrackColours <- NULL
for (C in 1:length(nColors)){
theTrackColours[mergedMedianPriceDF$Base.MSRP >= nColors[C] & mergedMedianPriceDF$Base.MSRP < nColors[C+1]] <- theColours[C]
}
plot(mergedMedianPriceDF$geometry, col = theTrackColours, lwd = 0.5)
plot(x = NULL, y = NULL, xlim = c(0,.1), ylim = c(0,length(nColors)-1), axes = FALSE, ann = FALSE)
for (c in 1:length(nColors)){
rect(0, c-1, .3, c, col = theColours[c], border = NA)
}
textLabels <- as.character(nColors[seq(1,length(nColors), 5)])
mtext(paste0("$", substr(textLabels,1,2), ",", substr(textLabels,3,5)), 4, at = seq(1,length(nColors), 5), las = 1, cex = .8, line = .1)
mtext("Median Price of\nCars", 3, font = 2)
baseMSRPbyLocation <- aggregate(Base.MSRP ~ LONGITUDE+LATITUDE, data = evData2, FUN = "median")
evData2Spatial <- st_as_sf(baseMSRPbyLocation,coords = c("LONGITUDE","LATITUDE"),crs = st_crs(censusTrackMap))
evDataSpatial.UTM <- st_transform(evData2Spatial, crs = "EPSG:26910")
censusTract.UTM <- st_transform(, crs = "EPSG:26910")
censusTrackMap.UTM <- st_transform(censusTrackMap, "EPSG:26910")
censusTrackMap.UTM.Kings <- censusTrackMap.UTM[censusTrackMap.UTM$NAMELSADCO == "King County", ]
IDXKings <- unique(unlist(st_intersects(censusTrackMap.UTM.Kings,evDataSpatial.UTM)))
evDataSpatial.UTM.Kings <- evDataSpatial.UTM[IDXKings, ]
grid <- st_make_grid(censusTrackMap.UTM.Kings, cellsize = 1000)
interpolatedValues <- idw(Base.MSRP~1, evDataSpatial.UTM.Kings, grid)
IDX <- unique(unlist(st_intersects(censusTrackMap.UTM.Kings,interpolatedValues)))
par(mai = c(0,0,.1,0), omi = c(0,0,.5,.6))
