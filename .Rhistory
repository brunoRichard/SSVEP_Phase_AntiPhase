library(sf)
library(gstat)
load("~/Library/CloudStorage/Box-Box/Teaching/Data Visualization/Fall 2024/Week 9/aggData.RData")
load("~/Library/CloudStorage/Box-Box/Teaching/Data Visualization/Fall 2024/Week 9/OurCountiesSHP.RData")
ourCounties
aggData.SP <- st_as_sf(aggData, coords = c("LONGITUDE", "LATITUDE"), crs = "NAD83")
aggData.SP.UTM <- st_transform(aggData.SP, crs = "EPSG:32618")
ourCounties.UTM <- st_transform(ourCounties, crs = "EPSG:32618")
theGrid <- st_make_grid(ourCounties.UTM, cellsize = 5000)
theInterpolation <- idw(HeatIndex~1, aggData.SP.UTM, theGrid, idp = 2.5)
out <- hist(aggData$HeatIndex, plot = FALSE)
nColours <- length(out$breaks)
theColours <- hcl.colors(nColours, palette = "Heat", alpha = .5)
theGridColour <- NULL
for (i in 1:nColours){
theGridColour[theInterpolation$var1.pred >= out$breaks[i] & theInterpolation$var1.pred < out$breaks[i+1]] <- theColours[i]
}
IDX <- st_intersects(ourCounties.UTM,theGrid)
IDXu <- unlist(IDX)
plot(ourCounties.UTM$geometry)
plot(theGrid[unique(IDXu)], col = theGridColour[unique(IDXu)], add = TRUE, border = NA)
IDX <- st_intersects(ourCounties.UTM,theGrid)
IDXu <- unlist(IDX)
plot(ourCounties.UTM$geometry)
plot(theGrid[unique(IDXu)], col = theGridColour[unique(IDXu)], add = TRUE, border = theGridColour[unique(IDXu)])
